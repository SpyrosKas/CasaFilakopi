{
  "name": "casa-filakopi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "db:types": "supabase gen types typescript --local > lib/db/types.ts",
    "test:e2e": "playwright test",
    "test:pay": "playwright test -c tests/pay-e2e/playwright.config.ts",
    "test:static": "playwright test -c playwright.static.config.ts",
    "test:prod": "playwright test -c playwright.prod.config.ts",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "baseline": "playwright test -c playwright.baseline.config.ts",
    "seed:invoices": "tsx scripts/seed-invoice-demo.ts",
    "migrate:content": "tsx scripts/migrate-content.ts",
    "migrate:media": "tsx scripts/migrate-media.ts",
    "load:drafts": "tsx scripts/load-drafts.ts",
    "visual": "playwright test -c tests/visual/playwright.config.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "0.8.3",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.37.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "exceljs": "4.4.0",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.7.1",
  "engines": {
    "node": ">=24"
  }
}

# Copy to .env.local. Never commit real values.
# Local values come from `supabase status`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines index only a production deployment on miloscasa.com, or a
# production deployment with this true. Leave empty on staging.
# NEXT_PUBLIC_INDEXABLE=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Email (Resend). Leave empty locally: mail then goes to Mailpit.
# Without a key in production, emails wait safely in the queue.
RESEND_API_KEY=
# From the webhook's page in Resend. Starts with whsec_.
RESEND_WEBHOOK_SECRET=
# Protects every /api/cron route. 32+ characters: openssl rand -hex 32
CRON_SECRET=
# Computes guests' private links. 32+ characters.
# Changing it breaks every link already sent.
# Generate with: openssl rand -base64 32
GUEST_TOKEN_SECRET=
# Optional, local only: mailpit (default) or memory, and Mailpit's address.
# EMAIL_DEV_TRANSPORT=mailpit
# MAILPIT_URL=http://127.0.0.1:54324

# Stripe. Leave all three empty and checkout stays closed: the booking pages
# show dates and prices, and point guests to the host. All three must be set,
# from the same mode (test with test, live with live).
# From Developers > API keys. Starts sk_test_ or sk_live_. Server only.
STRIPE_SECRET_KEY=
# From the same page. Starts pk_test_ or pk_live_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint for /api/stripe/webhook. Starts whsec_.
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile on the contact form and checkout. Required in production:
# without both keys the form closes and shows the phone and email, and checkout
# closes the same way. One key alone closes them everywhere. Skipped only
# outside production with neither set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional error tracking. Must be an EU project (*.ingest.de.sentry.io), or it
# stays off. Sends the event name and error type, never messages or guest data.
# SENTRY_DSN=

# Copy to .env.local. Never commit real values.
# Local values come from `supabase status`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Email (Resend). Leave empty locally: mail then goes to Mailpit.
# Without a key in production, emails wait safely in the queue.
RESEND_API_KEY=
# From the webhook's page in Resend. Starts with whsec_.
RESEND_WEBHOOK_SECRET=
# Protects /api/cron/email and /api/cron/email/scheduled. 32+ characters.
CRON_SECRET=
# Computes guests' private links. 32+ characters.
# Changing it breaks every link already sent.
# Generate with: openssl rand -base64 32
GUEST_TOKEN_SECRET=
# Optional, local only: mailpit (default) or memory, and Mailpit's address.
# EMAIL_DEV_TRANSPORT=mailpit
# MAILPIT_URL=http://127.0.0.1:54324

# Cloudflare Turnstile on the contact form. Required in production: without
# both keys the form closes and shows the phone and email. One key alone closes
# it everywhere. Skipped only outside production with neither set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
